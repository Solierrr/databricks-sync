SYNC_API_TOKEN=

SYNC_BATCH_SIZE=500

# Swagger em /docs e contrato em /openapi.json (false desliga os dois).
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
